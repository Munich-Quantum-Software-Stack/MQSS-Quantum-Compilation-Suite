// test-mqss-passes/code/cudaq/tests/ReverseCNotPass.test

// RUN: %mqss-cc %S/../ReverseCNotPass.cpp --passes=CommonCNOTReversePass | FileCheck %s

// CHECK: quake.h %[[V4:[A-Za-z0-9_]+]] : (!quake.ref) -> ()
// CHECK: quake.h %[[V3:[A-Za-z0-9_]+]] : (!quake.ref) -> ()
// CHECK: quake.x [%[[V4]]] %[[V3]] : (!quake.ref, !quake.ref) -> ()
// CHECK-NEXT: quake.h %[[V4]] : (!quake.ref) -> ()
// CHECK: quake.h %[[V3]] : (!quake.ref) -> ()
