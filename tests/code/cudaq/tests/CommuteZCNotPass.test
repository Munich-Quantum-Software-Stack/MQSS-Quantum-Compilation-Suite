// test-mqss-passes/code/cudaq/tests/CommuteZCNotPass.test

// RUN: %mqss-cc %S/../CommuteZCNotPass.cpp --passes=CommonCommutePass=mode=Z-CX | FileCheck %s

// CHECK: %[[V7:[A-Za-z0-9_]+]] = quake.extract_ref %[[V0:[A-Za-z0-9_]+]][0] : (!quake.veq<3>) -> !quake.ref
// CHECK-NEXT: quake.x [%{{[A-Za-z0-9_]+}}] %[[V7]] : (!quake.ref, !quake.ref) -> ()
// CHECK-NEXT: quake.z %{{[A-Za-z0-9_]+}} : (!quake.ref) -> ()
// CHECK: %{{[A-Za-z0-9_]+}} = quake.extract_ref %[[V0]][1] : (!quake.veq<3>) -> !quake.ref
