// test-mqss-passes/code/cudaq/tests/HToRzXRz.test

// RUN: %mqss-cc %S/../HToRzXRz.cpp --passes=CommonDecompositionPass=mode=HToRzXRz | FileCheck %s

// CHECK: %[[CST:[A-Za-z0-9_]+]] = arith.constant 3.1415926535897931 : f64
// CHECK: %[[CST_0:[A-Za-z0-9_]+]] = arith.constant 1.5707963267948966 : f64
// CHECK: quake.rz (%[[CST]]) %[[V3:[A-Za-z0-9_]+]] : (f64, !quake.ref) -> ()
// CHECK: quake.x %[[V3]] : (!quake.ref) -> ()
// CHECK: quake.rz (%[[CST_0]]) %[[V3]] : (f64, !quake.ref) -> ()
