// test-mqss-passes/code/cudaq/tests/HadamardAndXYZSwitchPass.test

// RUN: %mqss-cc %S/../HadamardAndXYZSwitchPass.cpp --passes=CommonSwitchPass=mode=HXYZtoXYZH | FileCheck %s

// CHECK: quake.h %2 : (!quake.ref) -> ()
// CHECK: %3 = quake.extract_ref %0[1] : (!quake.veq<2>) -> !quake.ref
// CHECK: %4 = quake.extract_ref %0[1] : (!quake.veq<2>) -> !quake.ref
// CHECK-NEXT: quake.z %4 : (!quake.ref) -> ()
// CHECK-NEXT: quake.h %3 : (!quake.ref) -> ()

// CHECK: quake.h %2 : (!quake.ref) -> ()
// CHECK: %3 = quake.extract_ref %0[1] : (!quake.veq<2>) -> !quake.ref
// CHECK: %4 = quake.extract_ref %0[1] : (!quake.veq<2>) -> !quake.ref
// CHECK-NEXT: quake.x %4 : (!quake.ref) -> ()
// CHECK-NEXT: quake.h %3 : (!quake.ref) -> ()

// CHECK: quake.h %2 : (!quake.ref) -> ()
// CHECK: %3 = quake.extract_ref %0[1] : (!quake.veq<2>) -> !quake.ref
// CHECK: %4 = quake.extract_ref %0[1] : (!quake.veq<2>) -> !quake.ref
// CHECK-NEXT: quake.y %4 : (!quake.ref) -> ()
// CHECK-NEXT: quake.h %3 : (!quake.ref) -> ()



