// test-mqss-passes/code/cudaq/tests/HadamardAndXYZSwitchPass.test

// RUN: %mqss-cc %S/../HadamardAndXYZSwitchPass.cpp --passes=CommonSwitchPass=mode=HXYZtoXYZH | FileCheck %s

// CHECK: quake.h %[[V2:[A-Za-z0-9_]+]] : (!quake.ref) -> ()
// CHECK: %[[V3:[A-Za-z0-9_]+]] = quake.extract_ref %[[V0:[A-Za-z0-9_]+]][1] : (!quake.veq<2>) -> !quake.ref
// CHECK: %[[V4:[A-Za-z0-9_]+]] = quake.extract_ref %[[V0]][1] : (!quake.veq<2>) -> !quake.ref
// CHECK-NEXT: quake.z %[[V4]] : (!quake.ref) -> ()
// CHECK-NEXT: quake.h %[[V3]] : (!quake.ref) -> ()

// CHECK: quake.h %[[V2]] : (!quake.ref) -> ()
// CHECK: %[[V3_2:[A-Za-z0-9_]+]] = quake.extract_ref %[[V0]][1] : (!quake.veq<2>) -> !quake.ref
// CHECK: %[[V4_2:[A-Za-z0-9_]+]] = quake.extract_ref %[[V0]][1] : (!quake.veq<2>) -> !quake.ref
// CHECK-NEXT: quake.x %[[V4_2]] : (!quake.ref) -> ()
// CHECK-NEXT: quake.h %[[V3_2]] : (!quake.ref) -> ()

// CHECK: quake.h %[[V2]] : (!quake.ref) -> ()
// CHECK: %[[V3_3:[A-Za-z0-9_]+]] = quake.extract_ref %[[V0]][1] : (!quake.veq<2>) -> !quake.ref
// CHECK: %[[V4_3:[A-Za-z0-9_]+]] = quake.extract_ref %[[V0]][1] : (!quake.veq<2>) -> !quake.ref
// CHECK-NEXT: quake.y %[[V4_3]] : (!quake.ref) -> ()
// CHECK-NEXT: quake.h %[[V3_3]] : (!quake.ref) -> ()
