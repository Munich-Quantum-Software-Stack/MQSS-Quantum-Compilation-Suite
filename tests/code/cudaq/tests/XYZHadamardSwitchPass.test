// test-mqss-passes/code/cudaq/tests/XYZHadamardSwitchPass.test

// RUN: %mqss-cc %S/../XYZHadamardSwitchPass.cpp --passes=CommonSwitchPass=mode=XYZHtoHXYZ | FileCheck %s

// CHECK: %[[V1:[A-Za-z0-9_]+]] = quake.extract_ref %[[V0:[A-Za-z0-9_]+]][0] : (!quake.veq<2>) -> !quake.ref
// CHECK: %[[V2:[A-Za-z0-9_]+]] = quake.extract_ref %[[V0]][0] : (!quake.veq<2>) -> !quake.ref
// CHECK: quake.h %[[V2]] : (!quake.ref) -> ()
// CHECK: quake.z %[[V1]] : (!quake.ref) -> ()

// CHECK: %[[V2_2:[A-Za-z0-9_]+]] = quake.extract_ref %[[V0]][0] : (!quake.veq<2>) -> !quake.ref
// CHECK: quake.h %[[V2_2]] : (!quake.ref) -> ()
// CHECK: quake.y %[[V1]] : (!quake.ref) -> ()
// CHECK: %{{[A-Za-z0-9_]+}} = quake.extract_ref %[[V0]][1] : (!quake.veq<2>) -> !quake.ref

// CHECK: %[[V2_3:[A-Za-z0-9_]+]] = quake.extract_ref %[[V0]][0] : (!quake.veq<2>) -> !quake.ref
// CHECK: quake.h %[[V2_3]] : (!quake.ref) -> ()
// CHECK: quake.x %[[V1]] : (!quake.ref) -> ()
// CHECK: %{{[A-Za-z0-9_]+}} = quake.extract_ref %[[V0]][1] : (!quake.veq<2>) -> !quake.ref
