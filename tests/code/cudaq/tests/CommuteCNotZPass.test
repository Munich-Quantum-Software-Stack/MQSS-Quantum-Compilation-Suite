// test-mqss-passes/code/cudaq/tests/CommuteCNotZPass.test

// RUN: %mqss-cc %S/../CommuteCNotZPass.cpp --passes=CommonCommutePass=mode=CX-Z | FileCheck %s

// CHECK: %[[V7:[A-Za-z0-9_]+]] = quake.extract_ref %[[V0:[A-Za-z0-9_]+]][1] : (!quake.veq<3>) -> !quake.ref
// CHECK: quake.z %[[V7]] : (!quake.ref) -> ()
// CHECK: quake.x [%{{[A-Za-z0-9_]+}}] %{{[A-Za-z0-9_]+}} : (!quake.ref, !quake.ref) -> ()
// CHECK: %{{[A-Za-z0-9_]+}} = quake.extract_ref %[[V0]][0] : (!quake.veq<3>) -> !quake.ref
