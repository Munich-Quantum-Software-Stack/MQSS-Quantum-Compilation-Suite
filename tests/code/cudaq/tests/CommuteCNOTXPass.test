// test-mqss-passes/code/cudaq/tests/CommuteCNotXPass.test

// RUN: %mqss-cc %S/../CommuteCNotXPass.cpp --passes=CommonCommutePass=mode=CX-X | FileCheck %s

// CHECK: quake.x %{{[A-Za-z0-9_]+}} : (!quake.ref) -> ()
// CHECK: quake.x [%{{[A-Za-z0-9_]+}}] %{{[A-Za-z0-9_]+}} : (!quake.ref, !quake.ref) -> ()
// CHECK: %[[V4:[A-Za-z0-9_]+]] = quake.extract_ref %[[V0:[A-Za-z0-9_]+]][1] : (!quake.veq<2>) -> !quake.ref
// CHECK: %[[V5:[A-Za-z0-9_]+]] = quake.extract_ref %[[V0]][0] : (!quake.veq<2>) -> !quake.ref
// CHECK: quake.x [%[[V4]]] %[[V5]] : (!quake.ref, !quake.ref) -> ()
// CHECK: %[[V6:[A-Za-z0-9_]+]] = quake.extract_ref %[[V0]][1] : (!quake.veq<2>) -> !quake.ref
// CHECK: quake.x %[[V6]] : (!quake.ref) -> ()
