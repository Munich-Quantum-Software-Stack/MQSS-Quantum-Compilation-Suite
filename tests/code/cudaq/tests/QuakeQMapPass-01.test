
// test-mqss-passes/code/cudaq/tests/QuakeQMapPass-01.test

// RUN: %mqss-cc %S/../QuakeQMapPass-01.cpp --passes=CommonMappingPass=input=/workspaces/MQSS-Passes-Suite/tests/input/qmap.json | sed -E 's/\x1b\[[0-9;]*m//g' | FileCheck %s

// CHECK: quake.x [%{{[A-Za-z0-9_]+}}] %{{[A-Za-z0-9_]+}} : (!quake.ref, !quake.ref) -> ()
// CHECK: %[[V5:[A-Za-z0-9_]+]] = quake.extract_ref %[[V0:[A-Za-z0-9_]+]][0] : (!quake.veq<5>) -> !quake.ref
// CHECK: %[[V6:[A-Za-z0-9_]+]] = quake.extract_ref %[[V0]][4] : (!quake.veq<5>) -> !quake.ref
// CHECK: quake.swap %[[V5]], %[[V6]] : (!quake.ref, !quake.ref) -> ()
// CHECK: %[[V7:[A-Za-z0-9_]+]] = quake.extract_ref %[[V0]][1] : (!quake.veq<5>) -> !quake.ref
// CHECK: %[[V8:[A-Za-z0-9_]+]] = quake.extract_ref %[[V0]][0] : (!quake.veq<5>) -> !quake.ref
// CHECK: quake.x [%[[V8]]] %[[V7]] : (!quake.ref, !quake.ref) -> ()
