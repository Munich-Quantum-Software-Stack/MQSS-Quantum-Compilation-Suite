// test-mqss-passes/code/cudaq/tests/DoubleCnotCancellationPass.test

// RUN: %mqss-cc %S/../DoubleCnotCancellationPass.cpp --passes=CommonGateCancellationPass=mode=CancelGate,cse,canonicalize | FileCheck %s

// CHECK: %0 = quake.alloca !quake.veq<2>
// CHECK: %1 = quake.extract_ref %0[1] : (!quake.veq<2>) -> !quake.ref
// CHECK: quake.x %1 : (!quake.ref) -> ()
// CHECK: %2 = quake.extract_ref %0[0] : (!quake.veq<2>) -> !quake.ref
// CHECK: quake.x [%2] %1 : (!quake.ref, !quake.ref) -> ()
// CHECK: quake.x %1 : (!quake.ref) -> ()
// CHECK: quake.x [%1] %2 : (!quake.ref, !quake.ref) -> ()


