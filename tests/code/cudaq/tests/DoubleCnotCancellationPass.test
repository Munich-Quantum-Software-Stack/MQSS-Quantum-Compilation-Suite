// test-mqss-passes/code/cudaq/tests/DoubleCnotCancellationPass.test

// RUN: %mqss-cc %S/../DoubleCnotCancellationPass.cpp --passes=CommonGateCancellationPass=mode=CancelGate,cse,canonicalize | FileCheck %s

// CHECK: %[[V0:[A-Za-z0-9_]+]] = quake.alloca !quake.veq<2>
// CHECK: %[[V1:[A-Za-z0-9_]+]] = quake.extract_ref %[[V0]][1] : (!quake.veq<2>) -> !quake.ref
// CHECK: quake.x %[[V1]] : (!quake.ref) -> ()
// CHECK: %[[V2:[A-Za-z0-9_]+]] = quake.extract_ref %[[V0]][0] : (!quake.veq<2>) -> !quake.ref
// CHECK: quake.x [%[[V2]]] %[[V1]] : (!quake.ref, !quake.ref) -> ()
// CHECK: quake.x %[[V1]] : (!quake.ref) -> ()
// CHECK: quake.x [%[[V1]]] %[[V2]] : (!quake.ref, !quake.ref) -> ()
