// test-mqss-passes/code/cudaq/tests/NullRotationCancellationPass.test

// RUN: %mqss-cc %S/../NullRotationCancellationPass.cpp --passes=CommonGateCancellationPass=mode=CancelNullRotation | FileCheck %s

// CHECK: quake.ry (%{{[A-Za-z0-9_]+}}) %{{[A-Za-z0-9_]+}} : (f64, !quake.ref) -> ()
// CHECK: %{{[A-Za-z0-9_]+}} = quake.extract_ref %[[V0:[A-Za-z0-9_]+]][0] : (!quake.veq<2>) -> !quake.ref
// CHECK: %[[V4:[A-Za-z0-9_]+]] = quake.extract_ref %[[V0]][1] : (!quake.veq<2>) -> !quake.ref
// CHECK: quake.rx (%{{[A-Za-z0-9_]+}}) %[[V4]] : (f64, !quake.ref) -> ()
// CHECK: %{{[A-Za-z0-9_]+}} = quake.extract_ref %[[V0]][0] : (!quake.veq<2>) -> !quake.ref
// CHECK: %[[V6:[A-Za-z0-9_]+]] = quake.extract_ref %[[V0]][1] : (!quake.veq<2>) -> !quake.ref
// CHECK: quake.rz (%{{[A-Za-z0-9_]+}}) %[[V6]] : (f64, !quake.ref) -> ()
