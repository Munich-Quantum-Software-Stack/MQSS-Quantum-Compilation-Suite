// test-mqss-passes/code/cudaq/tests/NullRotationCancellationPass.test

// RUN: %mqss-cc %S/../NullRotationCancellationPass.cpp --passes=CommonGateCancellationPass=mode=CancelNullRotation | FileCheck %s

// CHECK: quake.ry (%cst_1) %2 : (f64, !quake.ref) -> ()
// CHECK: %3 = quake.extract_ref %0[0] : (!quake.veq<2>) -> !quake.ref
// CHECK: %4 = quake.extract_ref %0[1] : (!quake.veq<2>) -> !quake.ref
// CHECK: quake.rx (%cst_0) %4 : (f64, !quake.ref) -> ()
// CHECK: %5 = quake.extract_ref %0[0] : (!quake.veq<2>) -> !quake.ref
// CHECK: %6 = quake.extract_ref %0[1] : (!quake.veq<2>) -> !quake.ref
// CHECK: quake.rz (%cst) %6 : (f64, !quake.ref) -> ()
