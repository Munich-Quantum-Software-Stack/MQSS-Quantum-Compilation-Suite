// test-mqss-passes/code/cudaq/tests/CommuteRxCNotPass.test

// RUN: %mqss-cc %S/../CommuteRxCNotPass.cpp --passes=CommonCommutePass=mode=RX-CX | FileCheck %s

// CHECK: %[[V4:[A-Za-z0-9_]+]] = quake.extract_ref %[[V0:[A-Za-z0-9_]+]][1] : (!quake.veq<3>) -> !quake.ref
// CHECK-NEXT: quake.x [%{{[A-Za-z0-9_]+}}] %[[V4]] : (!quake.ref, !quake.ref) -> ()
// CHECK-NEXT: quake.rx (%{{[A-Za-z0-9_]+}}) %{{[A-Za-z0-9_]+}} : (f64, !quake.ref) -> ()
// CHECK: %{{[A-Za-z0-9_]+}} = quake.extract_ref %[[V0]][1] : (!quake.veq<3>) -> !quake.ref
