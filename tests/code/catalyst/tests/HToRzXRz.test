
// test-mqss-passes/code/cudaq/tests/HToRzXRz.test

// RUN: %mqss-cc %S/../HToRzXRz.py --function circuit_HToRzXRz --passes=CommonDecompositionPass=mode=HToRzXRz | FileCheck %s

// CHECK:  %[[CST:[A-Za-z0-9_]+]] = arith.constant 3.1415926535897931 : f64
// CHECK:  %[[CST_0:[A-Za-z0-9_]+]] = arith.constant 1.5707963267948966 : f64
// CHECK:  %[[OUT_QUBITS_1:[A-Za-z0-9_]+]] = quantum.custom "RZ"(%[[CST]]) %{{[A-Za-z0-9_]+}}#0 : !quantum.bit
// CHECK:  %[[OUT_QUBITS_2:[A-Za-z0-9_]+]] = quantum.custom "PauliX"() %[[OUT_QUBITS_1]] : !quantum.bit
// CHECK:  %[[OUT_QUBITS_3:[A-Za-z0-9_]+]] = quantum.custom "RZ"(%[[CST_0]]) %[[OUT_QUBITS_2]] : !quantum.bit
// CHECK: %{{[A-Za-z0-9_]+}}, %{{[A-Za-z0-9_]+}} = quantum.measure %[[OUT_QUBITS_3]] : i1, !quantum.bit
