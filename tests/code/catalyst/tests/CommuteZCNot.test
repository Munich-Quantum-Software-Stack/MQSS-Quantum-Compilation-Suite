

// test-mqss-passes/code/catalyst/tests/CommuteZCNot.test

// RUN: %mqss-cc %S/../CommuteZCNot.py --function circuit_CommuteZCNot --passes=CommonCommutePass=mode=Z-CX | FileCheck %s

// CHECK: %[[OUT_QUBITS_2:[A-Za-z0-9_]+]]:2 = quantum.custom "CNOT"() %{{[A-Za-z0-9_]+}}, %{{[A-Za-z0-9_]+}} : !quantum.bit, !quantum.bit
// CHECK: %[[OUT_QUBITS_3:[A-Za-z0-9_]+]]:2 = quantum.custom "CNOT"() %[[OUT_QUBITS_2]]#1, %[[OUT_QUBITS_2]]#0 : !quantum.bit, !quantum.bit
// CHECK: %{{[A-Za-z0-9_]+}} = quantum.custom "PauliZ"() %[[OUT_QUBITS_3]]#0 : !quantum.bit
// CHECK: %{{[A-Za-z0-9_]+}} = quantum.custom "PauliZ"() %[[OUT_QUBITS_3]]#0 : !quantum.bit
