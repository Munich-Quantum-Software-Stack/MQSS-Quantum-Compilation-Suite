


// test-mqss-passes/code/cudaq/tests/QubitMapping-02.test

// RUN: %mqss-cc %S/../QubitMapping-02.py --function circuit_QubitMapping --passes=CommonMappingPass | sed -E 's/\x1b\[[0-9;]*m//g' | FileCheck %s


// CHECK: %{{[A-Za-z0-9_]+}}:2 = quantum.custom "CNOT"() %{{[A-Za-z0-9_]+}}, %{{[A-Za-z0-9_]+}} : !quantum.bit, !quantum.bit
// CHECK: %[[V5:[A-Za-z0-9_]+]] = quantum.extract %[[V0:[A-Za-z0-9_]+]][ 0] : !quantum.reg -> !quantum.bit
// CHECK: %[[V6:[A-Za-z0-9_]+]] = quantum.extract %[[V0]][ 4] : !quantum.reg -> !quantum.bit
// CHECK: %{{[A-Za-z0-9_]+}}:2 = quantum.custom "SWAP"() %[[V5]], %[[V6]] : !quantum.bit, !quantum.bit
// CHECK: %[[V7:[A-Za-z0-9_]+]] = quantum.extract %[[V0]][ 1] : !quantum.reg -> !quantum.bit
// CHECK: %[[V8:[A-Za-z0-9_]+]] = quantum.extract %[[V0]][ 0] : !quantum.reg -> !quantum.bit
// CHECK: %{{[A-Za-z0-9_]+}}:2 = quantum.custom "CNOT"() %[[V8]], %[[V7]] : !quantum.bit, !quantum.bit
// CHECK: %[[V9:[A-Za-z0-9_]+]] = quantum.extract %[[V0]][ 3] : !quantum.reg -> !quantum.bit
// CHECK: %[[CST:[A-Za-z0-9_]+]] = arith.constant 3.141600e+00 : f64
// CHECK: %{{[A-Za-z0-9_]+}} = quantum.custom "RY"(%[[CST]]) %[[V9]] : !quantum.bit
