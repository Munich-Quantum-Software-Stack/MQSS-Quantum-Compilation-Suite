// test-mqss-passes/code/catalyst/tests/CommuteRXCNOT.test

// RUN: %mqss-cc %S/../CommuteRXCNOT.py --function circuit_CommuteRXCNOT --passes=CommonCommutePass=mode=RX-CX | FileCheck %s

// CHECK: %[[OUT_QUBITS_2:[A-Za-z0-9_]+]]:2 = quantum.custom "CNOT"() %{{[A-Za-z0-9_]+}}, %{{[A-Za-z0-9_]+}} : !quantum.bit, !quantum.bit
// CHECK: %{{[A-Za-z0-9_]+}} = quantum.custom "RX"(%{{[A-Za-z0-9_]+}}) %[[OUT_QUBITS_2]]#1 : !quantum.bit
// CHECK: %[[OUT_QUBITS_4:[A-Za-z0-9_]+]] = quantum.custom "RX"(%{{[A-Za-z0-9_]+}}) %[[OUT_QUBITS_2]]#1 : !quantum.bit
// CHECK: %{{[A-Za-z0-9_]+}}:2 = quantum.custom "CNOT"() %[[OUT_QUBITS_4]], %[[OUT_QUBITS_2]]#0 : !quantum.bit, !quantum.bit
