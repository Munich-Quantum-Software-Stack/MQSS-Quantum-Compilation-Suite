

// test-mqss-passes/code/catalyst/tests/CxToHCzHDecomposition.test

// RUN: %mqss-cc %S/../CxToHCzHDecomposition.py --function circuit_CxToHCzH --passes=CommonDecompositionPass=mode=CxToHCzH | FileCheck %s


// CHECK: %[[OUT_QUBITS:[A-Za-z0-9_]+]] = quantum.custom "H"() %{{[A-Za-z0-9_]+}} : !quantum.bit
// CHECK: %[[OUT_QUBITS_0:[A-Za-z0-9_]+]]:2 = quantum.custom "CZ"() %{{[A-Za-z0-9_]+}}, %[[OUT_QUBITS]] : !quantum.bit, !quantum.bit
// CHECK: %[[OUT_QUBITS_1:[A-Za-z0-9_]+]] = quantum.custom "H"() %[[OUT_QUBITS_0]]#1 : !quantum.bit
// CHECK: %[[V3:[A-Za-z0-9_]+]] = quantum.insert %{{[A-Za-z0-9_]+}}[ 0], %[[OUT_QUBITS_0]]#0 : !quantum.reg, !quantum.bit
// CHECK: %{{[A-Za-z0-9_]+}} = quantum.insert %[[V3]][ 1], %[[OUT_QUBITS_1]] : !quantum.reg, !quantum.bit
