// test-mqss-passes/code/cudaq/tests/SAdjToSPass.test

// RUN: %mqss-cc %S/../SAdjToSPass.py --function circuit_SAdjZToS --passes=CommonReductionPass=mode=SAdjZToS,canonicalize | FileCheck %s

// CHECK: %out_qubits = quantum.custom "S"() %1 : !quantum.bit
