
// test-mqss-passes/code/cudaq/tests/StoSAdjPass.test

// RUN: %mqss-cc %S/../StoSAdjPass.py --function circuit_SZToSAdj --passes=CommonReductionPass=mode=SZToSAdj,canonicalize | FileCheck %s


// CHECK: %[[OUT_QUBITS:[A-Za-z0-9_]+]] = quantum.custom "S"() %{{[A-Za-z0-9_]+}} adj : !quantum.bit
// CHECK: %[[V2:[A-Za-z0-9_]+]] = quantum.extract %[[V0:[A-Za-z0-9_]+]][ 1] : !quantum.reg -> !quantum.bit
// CHECK: %[[OUT_QUBITS_0:[A-Za-z0-9_]+]] = quantum.custom "S"() %[[V2]] adj : !quantum.bit
// CHECK: %[[V3:[A-Za-z0-9_]+]] = quantum.insert %[[V0]][ 0], %[[OUT_QUBITS]] : !quantum.reg, !quantum.bit
// CHECK: %{{[A-Za-z0-9_]+}} = quantum.insert %[[V3]][ 1], %[[OUT_QUBITS_0]] : !quantum.reg, !quantum.bit
