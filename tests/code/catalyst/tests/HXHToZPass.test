// test-mqss-passes/code/cudaq/tests/HXHToZPass.test

// RUN: %mqss-cc %S/../HXHToZ.py --function circuit_HXHToZ --passes=CommonReductionPass=mode=HXHToZ,canonicalize | FileCheck %s

// CHECK: %out_qubits = quantum.custom "PauliZ"() %1 : !quantum.bit
// CHECK: %2 = quantum.extract %0[ 1] : !quantum.reg -> !quantum.bit
// CHECK: %out_qubits_0 = quantum.custom "Hadamard"() %2 : !quantum.bit
// CHECK: %out_qubits_1:2 = quantum.custom "CNOT"() %out_qubits, %out_qubits_0 : !quantum.bit, !quantum.bit

