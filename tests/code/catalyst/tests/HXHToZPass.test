// test-mqss-passes/code/cudaq/tests/HXHToZPass.test

// RUN: %mqss-cc %S/../HXHToZ.py --function circuit_HXHToZ --passes=CommonReductionPass=mode=HXHToZ,canonicalize | FileCheck %s

// CHECK: %[[OUT_QUBITS:[A-Za-z0-9_]+]] = quantum.custom "PauliZ"() %{{[A-Za-z0-9_]+}} : !quantum.bit
// CHECK: %[[V2:[A-Za-z0-9_]+]] = quantum.extract %{{[A-Za-z0-9_]+}}[ 1] : !quantum.reg -> !quantum.bit
// CHECK: %[[OUT_QUBITS_0:[A-Za-z0-9_]+]] = quantum.custom "Hadamard"() %[[V2]] : !quantum.bit
// CHECK: %{{[A-Za-z0-9_]+}}:2 = quantum.custom "CNOT"() %[[OUT_QUBITS]], %[[OUT_QUBITS_0]] : !quantum.bit, !quantum.bit
