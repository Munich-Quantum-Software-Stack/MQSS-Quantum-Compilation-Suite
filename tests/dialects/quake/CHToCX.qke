
// RUN: %mqss-opt %s --CommonDecompositionPass=mode=CHToCX 2>&1 | FileCheck %s

func.func @circuit() attributes {"cudaq-entrypoint", "cudaq-kernel"}{
  %0 = quake.alloca !quake.veq<2>
  %1 = quake.extract_ref %0[0] : (!quake.veq<2>) -> !quake.ref
  %2 = quake.extract_ref %0[1] : (!quake.veq<2>) -> !quake.ref
  quake.h [%1] %2 : (!quake.ref, !quake.ref) -> ()
  return
}

// CHECK: quake.s %2 : (!quake.ref) -> ()
// CHECK: quake.h %2 : (!quake.ref) -> ()
// CHECK: quake.t %2 : (!quake.ref) -> ()
// CHECK: quake.x [%1] %2 : (!quake.ref, !quake.ref) -> ()
// CHECK: quake.t<adj> %2 : (!quake.ref) -> ()
// CHECK: quake.h %2 : (!quake.ref) -> ()
// CHECK: quake.s<adj> %2 : (!quake.ref) -> ()
