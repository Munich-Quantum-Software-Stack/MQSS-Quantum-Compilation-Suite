
// RUN: %mqss-opt %s --CommonSwitchPass=mode=XYZHtoHXYZ --CommonReductionPass=mode=SZToSAdj 2>&1 | FileCheck %s

// CommonSwitchPass conjugates the PauliX through the Hadamard in the first kernel,
// while CommonReductionPass independently reduces the S,PauliZ pair to S<adj> in the
// second kernel of the same module.
module attributes {cc.sizeof_string = 24 : i64, llvm.data_layout = "e-m:e-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128", llvm.triple = "aarch64-unknown-linux-gnu", quake.mangled_name_map = {__nvqpp__mlirgen__testILm2EE = "_ZN4testILm2EEclEv"}} {
  func.func @__nvqpp__mlirgen__testILm2EE() attributes {"cudaq-entrypoint", "cudaq-kernel"} {
    %0 = quake.alloca !quake.veq<2>
    %1 = quake.extract_ref %0[0] : (!quake.veq<2>) -> !quake.ref
    quake.x %1 : (!quake.ref) -> ()
    %2 = quake.extract_ref %0[0] : (!quake.veq<2>) -> !quake.ref
    quake.h %2 : (!quake.ref) -> ()
    %3 = quake.extract_ref %0[1] : (!quake.veq<2>) -> !quake.ref
    %measOut = quake.mz %0 : (!quake.veq<2>) -> !cc.stdvec<!quake.measure>
    return
  }
  func.func @_ZN4testILm2EEclEv(%arg0: !cc.ptr<i8>) {
    return
  }
  func.func @__nvqpp__mlirgen__test1ILm2EE() attributes {"cudaq-entrypoint", "cudaq-kernel"} {
    %0 = quake.alloca !quake.veq<2>
    %1 = quake.extract_ref %0[0] : (!quake.veq<2>) -> !quake.ref
    quake.s %1 : (!quake.ref) -> ()
    %2 = quake.extract_ref %0[0] : (!quake.veq<2>) -> !quake.ref
    quake.z %2 : (!quake.ref) -> ()
    %3 = quake.extract_ref %0[1] : (!quake.veq<2>) -> !quake.ref
    %measOut1 = quake.mz %0 : (!quake.veq<2>) -> !cc.stdvec<!quake.measure>
    return
  }
}

// First kernel: "X then H" was switched to "H then Z", so the H now acts on
// the second extracted qubit and the Z on the first one.
// CHECK: %[[V1:[A-Za-z0-9_]+]] = quake.extract_ref %{{[A-Za-z0-9_]+}}[0] : (!quake.veq<2>) -> !quake.ref
// CHECK: %[[V2:[A-Za-z0-9_]+]] = quake.extract_ref %{{[A-Za-z0-9_]+}}[0] : (!quake.veq<2>) -> !quake.ref
// CHECK: quake.h %[[V2]] : (!quake.ref) -> ()
// CHECK: quake.z %[[V1]] : (!quake.ref) -> ()

// Second kernel: S followed by Z was reduced to S-adjoint.
// CHECK: %[[V3:[A-Za-z0-9_]+]] = quake.extract_ref %{{[A-Za-z0-9_]+}}[0] : (!quake.veq<2>) -> !quake.ref
// CHECK: quake.s<adj> %[[V3]] : (!quake.ref) -> ()
