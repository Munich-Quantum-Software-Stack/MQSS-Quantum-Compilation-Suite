
// RUN: %mqss-cudaq-opt %s --CommonDecompositionPass=mode=HToRzXRz 2>&1 | FileCheck %s

func.func @__nvqpp__mlirgen__ghzILm2EE() attributes {"cudaq-entrypoint", "cudaq-kernel"} {
  %0 = quake.alloca !quake.veq<2>
  %1 = quake.extract_ref %0[0] : (!quake.veq<2>) -> !quake.ref
  %2 = quake.extract_ref %0[1] : (!quake.veq<2>) -> !quake.ref
  quake.x [%1] %2 : (!quake.ref, !quake.ref) -> ()
  %3 = quake.extract_ref %0[0] : (!quake.veq<2>) -> !quake.ref
  quake.h %3 : (!quake.ref) -> ()
  %measOut = quake.mz %0 : (!quake.veq<2>) -> !cc.stdvec<!quake.measure>
  return
}

// CHECK: %cst = arith.constant 3.1415926535897931 : f64
// CHECK: %cst_0 = arith.constant 1.5707963267948966 : f64
// CHECK: quake.rz (%cst) %3 : (f64, !quake.ref) -> ()
// CHECK: quake.x %3 : (!quake.ref) -> ()
// CHECK: quake.rz (%cst_0) %3 : (f64, !quake.ref) -> ()