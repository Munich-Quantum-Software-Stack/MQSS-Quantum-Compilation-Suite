
// RUN: %mqss-opt %s --CommonNormalizeArgAnglePass 2>&1 | FileCheck %s

module attributes {cc.sizeof_string = 24 : i64, llvm.data_layout = "e-m:e-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128", llvm.triple = "aarch64-unknown-linux-gnu", quake.mangled_name_map = {__nvqpp__mlirgen__testILm2EE = "_ZN4testILm2EEclEv"}} {
  func.func @__nvqpp__mlirgen__testILm2EE() attributes {"cudaq-entrypoint", "cudaq-kernel"} {
    %cst = arith.constant 3.314160e+01 : f64
    %cst_0 = arith.constant 2.000000e+01 : f64
    %cst_1 = arith.constant 1.130000e+01 : f64
    %cst_2 = arith.constant 3.141600e+00 : f64
    %cst_3 = arith.constant 2.000000e+00 : f64
    %cst_4 = arith.constant 1.300000e+00 : f64
    %0 = quake.alloca !quake.veq<2>
    %1 = quake.extract_ref %0[1] : (!quake.veq<2>) -> !quake.ref
    quake.rx (%cst_4) %1 : (f64, !quake.ref) -> ()
    %2 = quake.extract_ref %0[0] : (!quake.veq<2>) -> !quake.ref
    quake.ry (%cst_3) %2 : (f64, !quake.ref) -> ()
    %3 = quake.extract_ref %0[0] : (!quake.veq<2>) -> !quake.ref
    quake.rz (%cst_2) %3 : (f64, !quake.ref) -> ()
    %4 = quake.extract_ref %0[1] : (!quake.veq<2>) -> !quake.ref
    quake.rx (%cst_1) %4 : (f64, !quake.ref) -> ()
    %5 = quake.extract_ref %0[0] : (!quake.veq<2>) -> !quake.ref
    quake.ry (%cst_0) %5 : (f64, !quake.ref) -> ()
    %6 = quake.extract_ref %0[1] : (!quake.veq<2>) -> !quake.ref
    quake.rz (%cst) %6 : (f64, !quake.ref) -> ()
    %measOut = quake.mz %0 : (!quake.veq<2>) -> !cc.stdvec<!quake.measure>
    return
  }
  func.func @_ZN4testILm2EEclEv(%arg0: !cc.ptr<i8>) {
    return
  }
}

// CHECK:  %1 = quake.extract_ref %0[1] : (!quake.veq<2>) -> !quake.ref
// CHECK:  %cst_5 = arith.constant 1.300000e+00 : f64
// CHECK:  quake.rx (%cst_4) %1 : (f64, !quake.ref) -> ()
// CHECK:  %2 = quake.extract_ref %0[0] : (!quake.veq<2>) -> !quake.ref
// CHECK:  %cst_6 = arith.constant 2.000000e+00 : f64
// CHECK:  quake.ry (%cst_3) %2 : (f64, !quake.ref) -> ()
// CHECK:  %3 = quake.extract_ref %0[0] : (!quake.veq<2>) -> !quake.ref
// CHECK:  %cst_7 = arith.constant 3.141600e+00 : f64
// CHECK:  quake.rz (%cst_2) %3 : (f64, !quake.ref) -> ()
// CHECK:  %4 = quake.extract_ref %0[1] : (!quake.veq<2>) -> !quake.ref
// CHECK:  %cst_8 = arith.constant 5.0168146928204145 : f64
// CHECK:  quake.rx (%cst_1) %4 : (f64, !quake.ref) -> ()
// CHECK:  %5 = quake.extract_ref %0[0] : (!quake.veq<2>) -> !quake.ref
// CHECK:  %cst_9 = arith.constant 1.1504440784612413 : f64
// CHECK:  quake.ry (%cst_0) %5 : (f64, !quake.ref) -> ()
// CHECK:  %6 = quake.extract_ref %0[1] : (!quake.veq<2>) -> !quake.ref
// CHECK:  %cst_10 = arith.constant 1.7256734641020657 : f64
// CHECK:  quake.rz (%cst) %6 : (f64, !quake.ref) -> ()