
// RUN: %mqss-opt %s --BasisConversionPass=gates=h,cz --CommonGateCancellationPass=mode=CancelGate --lower-quake-to-qir=profile=qir-base:2.0 -o /dev/null 2>&1 | FileCheck %s

// A three-stage pipeline mirroring the catalyst-quantum version: legalize the CX into
// the {h,cz} native gate set via BasisConversionPass (recursively rewriting it to
// H-CZ-H), cancel the resulting run of three consecutive Hadamards down to one, then
// lower the simplified kernel all the way to QIR base-profile LLVM IR.
module attributes {cc.sizeof_string = 24 : i64, llvm.data_layout = "e-m:e-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128", llvm.triple = "aarch64-unknown-linux-gnu", quake.mangled_name_map = {__nvqpp__mlirgen__testILm2EE = "_ZN4testILm2EEclEv"}} {
  func.func @__nvqpp__mlirgen__testILm2EE() attributes {"cudaq-entrypoint", "cudaq-kernel"} {
    %0 = quake.alloca !quake.veq<2>
    %1 = quake.extract_ref %0[0] : (!quake.veq<2>) -> !quake.ref
    %2 = quake.extract_ref %0[1] : (!quake.veq<2>) -> !quake.ref
    quake.x [%1] %2 : (!quake.ref, !quake.ref) -> ()
    quake.h %2 : (!quake.ref) -> ()
    quake.h %2 : (!quake.ref) -> ()
    %measOut = quake.mz %0 : (!quake.veq<2>) -> !cc.stdvec<!quake.measure>
    return
  }
  func.func @_ZN4testILm2EEclEv(%arg0: !cc.ptr<i8>) {
    return
  }
}

// CHECK: define void @__nvqpp__mlirgen__testILm2EE() #0 {
// CHECK:   call void @__quantum__qis__h__body(ptr inttoptr (i64 1 to ptr))
// CHECK:   call void @__quantum__qis__cz__body(ptr null, ptr inttoptr (i64 1 to ptr))
// CHECK:   call void @__quantum__qis__h__body(ptr inttoptr (i64 1 to ptr))
// CHECK:   call void @__quantum__qis__mz__body(ptr @__nvqpp__mlirgen__testILm2EE.rodata_0, ptr null)
// CHECK:   call void @__quantum__rt__array_record_output(i64 1, ptr @cstr.61727261793C6931207820313E00)
// CHECK:   call void @__quantum__rt__result_record_output(ptr null, ptr @cstr.72303030303000)
// CHECK:   ret void
// CHECK: }
