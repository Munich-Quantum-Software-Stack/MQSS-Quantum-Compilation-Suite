

// RUN: %mqss-opt %s --CommonSwitchPass=mode=XYZHtoHXYZ 2>&1 | FileCheck %s
module attributes {cc.sizeof_string = 24 : i64, llvm.data_layout = "e-m:e-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128", llvm.triple = "aarch64-unknown-linux-gnu", quake.mangled_name_map = {__nvqpp__mlirgen__testILm2EE = "_ZN4testILm2EEclEv"}} {
  func.func @__nvqpp__mlirgen__testILm2EE() attributes {"cudaq-entrypoint", "cudaq-kernel"} {
    %0 = quake.alloca !quake.veq<2>
    %1 = quake.extract_ref %0[0] : (!quake.veq<2>) -> !quake.ref
    quake.x %1 : (!quake.ref) -> ()
    %2 = quake.extract_ref %0[0] : (!quake.veq<2>) -> !quake.ref
    quake.h %2 : (!quake.ref) -> ()
    %3 = quake.extract_ref %0[1] : (!quake.veq<2>) -> !quake.ref
    quake.h %3 : (!quake.ref) -> ()
    %4 = quake.extract_ref %0[1] : (!quake.veq<2>) -> !quake.ref
    quake.x %4 : (!quake.ref) -> ()

// CHECK: %[[V1:[A-Za-z0-9_]+]] = quake.extract_ref %[[V0:[A-Za-z0-9_]+]][0] : (!quake.veq<2>) -> !quake.ref
// CHECK: %[[V2:[A-Za-z0-9_]+]] = quake.extract_ref %[[V0]][0] : (!quake.veq<2>) -> !quake.ref
// CHECK: quake.h %[[V2]] : (!quake.ref) -> ()
// CHECK: quake.z %[[V1]] : (!quake.ref) -> ()

    %measOut = quake.mz %0 : (!quake.veq<2>) -> !cc.stdvec<!quake.measure>
    return
  }

  func.func @__nvqpp__mlirgen__test1ILm2EE() attributes {"cudaq-entrypoint", "cudaq-kernel"} {
    %0 = quake.alloca !quake.veq<2>
    %1 = quake.extract_ref %0[0] : (!quake.veq<2>) -> !quake.ref
    quake.y %1 : (!quake.ref) -> ()
    %2 = quake.extract_ref %0[0] : (!quake.veq<2>) -> !quake.ref
    quake.h %2 : (!quake.ref) -> ()

// CHECK: %[[Y1:[A-Za-z0-9_]+]] = quake.extract_ref %[[REG_Y:[A-Za-z0-9_]+]][0] : (!quake.veq<2>) -> !quake.ref
// CHECK: %[[Y2:[A-Za-z0-9_]+]] = quake.extract_ref %[[REG_Y]][0] : (!quake.veq<2>) -> !quake.ref
// CHECK: quake.h %[[Y2]] : (!quake.ref) -> ()
// CHECK: quake.y %[[Y1]] : (!quake.ref) -> ()
// CHECK: %{{[A-Za-z0-9_]+}} = quake.extract_ref %[[REG_Y]][1] : (!quake.veq<2>) -> !quake.ref

    %3 = quake.extract_ref %0[1] : (!quake.veq<2>) -> !quake.ref
    quake.h %3 : (!quake.ref) -> ()
    %4 = quake.extract_ref %0[1] : (!quake.veq<2>) -> !quake.ref
    quake.y %4 : (!quake.ref) -> ()
    %measOut = quake.mz %0 : (!quake.veq<2>) -> !cc.stdvec<!quake.measure>
    return
  }
  func.func @__nvqpp__mlirgen__test2ILm2EE() attributes {"cudaq-entrypoint", "cudaq-kernel"} {
    %0 = quake.alloca !quake.veq<2>
    %1 = quake.extract_ref %0[0] : (!quake.veq<2>) -> !quake.ref
    quake.z %1 : (!quake.ref) -> ()
    %2 = quake.extract_ref %0[0] : (!quake.veq<2>) -> !quake.ref
    quake.h %2 : (!quake.ref) -> ()

// CHECK: %[[Z1:[A-Za-z0-9_]+]] = quake.extract_ref %[[REG_Z:[A-Za-z0-9_]+]][0] : (!quake.veq<2>) -> !quake.ref
// CHECK: %[[Z2:[A-Za-z0-9_]+]] = quake.extract_ref %[[REG_Z]][0] : (!quake.veq<2>) -> !quake.ref
// CHECK: quake.h %[[Z2]] : (!quake.ref) -> ()
// CHECK: quake.x %[[Z1]] : (!quake.ref) -> ()
// CHECK: %{{[A-Za-z0-9_]+}} = quake.extract_ref %[[REG_Z]][1] : (!quake.veq<2>) -> !quake.ref

    %3 = quake.extract_ref %0[1] : (!quake.veq<2>) -> !quake.ref
    quake.h %3 : (!quake.ref) -> ()
    %4 = quake.extract_ref %0[1] : (!quake.veq<2>) -> !quake.ref
    quake.z %4 : (!quake.ref) -> ()
    %measOut = quake.mz %0 : (!quake.veq<2>) -> !cc.stdvec<!quake.measure>
    return
  }

}
