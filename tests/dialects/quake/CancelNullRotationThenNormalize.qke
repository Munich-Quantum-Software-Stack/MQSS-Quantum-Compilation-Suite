
// RUN: %mqss-opt %s --CommonGateCancellationPass=mode=CancelNullRotation --CommonNormalizeArgAnglePass 2>&1 | FileCheck %s

// CommonGateCancellationPass removes the zero-angle RX entirely, and
// CommonNormalizeArgAnglePass then wraps the surviving RZ's angle into [0, 2*pi).
module attributes {cc.sizeof_string = 24 : i64, llvm.data_layout = "e-m:e-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128", llvm.triple = "aarch64-unknown-linux-gnu", quake.mangled_name_map = {__nvqpp__mlirgen__testILm2EE = "_ZN4testILm2EEclEv"}} {
  func.func @__nvqpp__mlirgen__testILm2EE() attributes {"cudaq-entrypoint", "cudaq-kernel"} {
    %cst = arith.constant 0.000000e+00 : f64
    %cst_0 = arith.constant 1.130000e+01 : f64
    %0 = quake.alloca !quake.veq<2>
    %1 = quake.extract_ref %0[0] : (!quake.veq<2>) -> !quake.ref
    quake.rx (%cst) %1 : (f64, !quake.ref) -> ()
    %2 = quake.extract_ref %0[1] : (!quake.veq<2>) -> !quake.ref
    quake.rz (%cst_0) %2 : (f64, !quake.ref) -> ()
    %measOut = quake.mz %0 : (!quake.veq<2>) -> !cc.stdvec<!quake.measure>
    return
  }
  func.func @_ZN4testILm2EEclEv(%arg0: !cc.ptr<i8>) {
    return
  }
}

// CHECK: %1 = quake.extract_ref %0[0] : (!quake.veq<2>) -> !quake.ref
// CHECK: %2 = quake.extract_ref %0[1] : (!quake.veq<2>) -> !quake.ref
// CHECK: %cst_1 = arith.constant 5.0168146928204145 : f64
// CHECK: quake.rz (%cst_0) %2 : (f64, !quake.ref) -> ()
// CHECK: %measOut = quake.mz %0 : (!quake.veq<2>) -> !cc.stdvec<!quake.measure>
