
// RUN: %mqss-opt %s --CommonCNOTReversePass --CommonDecompositionPass=mode=CxToHCzH 2>&1 | FileCheck %s

// CommonCNOTReversePass first rewrites the CNOT into an H-CX-H sandwich with control
// and target swapped; CommonDecompositionPass then expands every CX (including the
// original) it finds into the H-CZ-H form.
module attributes {cc.sizeof_string = 24 : i64, llvm.data_layout = "e-m:e-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128", llvm.triple = "aarch64-unknown-linux-gnu", quake.mangled_name_map = {__nvqpp__mlirgen__testILm2EE = "_ZN4testILm2EEclEv"}} {
  func.func @__nvqpp__mlirgen__testILm2EE() attributes {"cudaq-entrypoint", "cudaq-kernel"} {
    %0 = quake.alloca !quake.veq<2>
    %1 = quake.extract_ref %0[1] : (!quake.veq<2>) -> !quake.ref
    %2 = quake.extract_ref %0[0] : (!quake.veq<2>) -> !quake.ref
    quake.x [%1] %2 : (!quake.ref, !quake.ref) -> ()
    %measOut = quake.mz %0 : (!quake.veq<2>) -> !cc.stdvec<!quake.measure>
    return
  }
  func.func @_ZN4testILm2EEclEv(%arg0: !cc.ptr<i8>) {
    return
  }
}

// CHECK: %1 = quake.extract_ref %0[1] : (!quake.veq<2>) -> !quake.ref
// CHECK: %2 = quake.extract_ref %0[0] : (!quake.veq<2>) -> !quake.ref
// CHECK: quake.h %2 : (!quake.ref) -> ()
// CHECK: quake.z [%1] %2 : (!quake.ref, !quake.ref) -> ()
// CHECK: quake.h %2 : (!quake.ref) -> ()
// CHECK: quake.h %2 : (!quake.ref) -> ()
// CHECK: quake.h %1 : (!quake.ref) -> ()
// CHECK: quake.h %1 : (!quake.ref) -> ()
// CHECK: quake.z [%2] %1 : (!quake.ref, !quake.ref) -> ()
// CHECK: quake.h %1 : (!quake.ref) -> ()
// CHECK: quake.h %2 : (!quake.ref) -> ()
// CHECK: quake.h %1 : (!quake.ref) -> ()
