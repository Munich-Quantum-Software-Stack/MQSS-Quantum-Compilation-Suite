{
  "name": "mqss-pass-dev",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "workspaceFolder": "/workspaces/MQSS-Passes-Suite",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "twxs.cmake",
        "ms-vscode.cmake-tools",
        "cschlosser.doxdocgen",
        "psioniq.psi-header",
        "streetsidesoftware.code-spell-checker",
        "davidanson.vscode-markdownlint",
        "takumii.markdowntable",
        "stkb.rewrap",
        "qiu.llvm-ir-language-support",
        "llvm-vs-code-extensions.vscode-mlir",
        "ms-azuretools.vscode-docker",
        "ritwickdey.liveserver",
        "llvm-vs-code-extensions.vscode-clangd"
      ],
      "settings": {
        "clangd.path": "/usr/local/bin/clangd",
        "clangd.arguments": [
          "--compile-commands-dir=/workspaces/MQSS-Passes-Suite/build"
        ],
        "files.associations": {
          "CMakeLists.txt": "cmake",
          "*.cmake.in": "cmake",
          "*.td": "tablegen",
          "*.h.in": "cpp",
          "*.sh.in": "shellscript",
          "*.qke": "mlir",
          "*.mlir": "mlir"
        },
        "markdownlint.config": {
          "MD013": { "tables": false, "code_blocks": false },
          "MD033": { "allowed_elements": ["br"] }
        },
        "markdownlint.run": "onSave",
        "[markdown]": {
          "editor.formatOnSave": true,
          "editor.formatOnPaste": true,
          "files.trimTrailingWhitespace": true
        },
        "cSpell.userWords": [
          "MLIR",
          "LLVM",
          "bitcode",
          "Quake",
          "catalyst",
          "qubit",
          "qubits"
        ],
        "[python]": {
          "editor.formatOnType": true
        },
        "C_Cpp.inlayHints.autoDeclarationTypes.enabled": false,
        "C_Cpp.inlayHints.referenceOperator.enabled": false,
        "C_Cpp.doxygen.generateOnType": false,
        "C_Cpp.default.cStandard": "c17",
        "C_Cpp.default.cppStandard": "c++20",
        "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
        "C_Cpp.default.compileCommands": "${workspaceFolder}/build/compile_commands.json",
        "C_Cpp.default.includePath": [
          "${workspaceFolder}/**",
          "/usr/include/c++/**",
          "/usr/include/**/c++/**"
        ],
        "doxdocgen.c.triggerSequence": "///",
        "doxdocgen.c.firstLine": "",
        "doxdocgen.c.commentPrefix": "/// ",
        "doxdocgen.c.lastLine": "",
        "doxdocgen.file.fileOrder": ["brief", "date"],
        "doxdocgen.generic.order": ["brief", "tparam", "param", "return", "exception"]
      }
    }
  },
"postCreateCommand": "make -C /workspaces/MQSS-Passes-Suite setup-env && echo 'eval \"$(make set-target-paths)\"' >> ~/.bashrc"
}
