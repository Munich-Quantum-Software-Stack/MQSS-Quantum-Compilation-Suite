#!/usr/bin/env bash

# Simple driver for selecting the correct optimizer

############# Pretty-print variables#################


msg() {
  printf '%s\n' "$1"
}

blank() {
  printf '\n'
}

section() {
  blank
  printf '====== %s ======\n' "$1"
  blank
}

info() {
  printf '🔧 %s\n' "$1"
}

fail() {
  printf '❌ %s\n' "$1"
}


ok() {
  printf '✅ %s\n' "$1"
}

warn() {
  printf '⚠️ %s\n' "$1"
}

step() {
  printf '-> %s\n' "$1"
}


for cmd in mqss-opt mqss-opt mqss-cc; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        echo "$cmd not found"
    fi
done

while getopts "h" opt; do
  case "$opt" in
    h) mqss-opt -h; usage; exit 0 ;;
    *) mqss-opt -h; usage; exit 1 ;;
  esac
done

PASSES=""
OTHER_ARGS=()

# MQSS_INSTALL_DIR="/workspaces/mqss-install"
# # The following paths should be set on the command-line

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"


if [[ $# -lt 1 ]]; then
  usage
  exit 1
fi

INPUT_FILE="$1"
shift

if [[ ! -f "${INPUT_FILE}" ]]; then
  echo "Error: input file not found: ${INPUT_FILE}" >&2
  exit 1
fi

EXT="${INPUT_FILE##*.}"
FUNCTION_NAME=""
RESOLVER="${SCRIPT_DIR}/resolve_python_input.py"
STAGE="HLOLoweringStage"
OUT_DIR=""
TOOL_ARGS=()

EMIT_QIR=OFF
DEBUG_ONLY=""
OUT_FORMAT=""
# Parse arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    --out-dir)
      OUT_DIR="$2"
      shift 2
      ;;
    --convert-to=*)
      OUT_FORMAT="${1#--convert-to=}"
      if [[ "$OUT_FORMAT" != "qasm2" && "$OUT_FORMAT" != "qir" ]]; then
        echo "Error: unsupported format '$OUT_FORMAT'. Expected 'qasm2' or 'qir'." >&2
        exit 1
      fi
      shift
      ;;
    --function)
      if [[ "${EXT}" != "py" ]]; then
        echo "Error: --function is only valid for Python input." >&2
        exit 1
      fi
      FUNCTION_NAME="$2"
      shift 2
      ;;
    --stage)
      if [[ "${EXT}" != "py" ]]; then
        echo "Error: --stage is only valid for Python input." >&2
        exit 1
      fi
      STAGE="$2"
      shift 2
      ;;

    --resolver)
      if [[ "${EXT}" != "py" ]]; then
        echo "Error: --resolver is only valid for Python input." >&2
        exit 1
      fi
      RESOLVER="$2"
      shift 2
      ;;
      --passes=*)
        PASSES="${1#--passes=}"
        shift          # <-- shift, not break
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage
      exit 1
      ;;
  esac
done

# TODO: Following code needs improvement
if [[ -z "$INPUT_FILE" ]]; then
echo "No valid input file found!"
exit 1
fi

# Split passes at commas
MQSS_PASS_ARGS=()
IFS=',' read -ra PASS_LIST <<< "$PASSES"

i=0
while (( i < ${#PASS_LIST[@]} )); do
  p="${PASS_LIST[i]}"

  if [[ "$p" == *"("* && "$p" != *")"* ]]; then
    # Opening "(" but no closing ")": absorb tokens until one closes it.
    joined="$p"
    (( i++ ))
    while (( i < ${#PASS_LIST[@]} )); do
      joined+=",${PASS_LIST[i]}"
      [[ "${PASS_LIST[i]}" == *")"* ]] && { (( i++ )); break; }
      (( i++ ))
    done
    joined="${joined//(/}"   # remove all "("
    joined="${joined//)/}"   # remove all ")"
    MQSS_PASS_ARGS+=("--$joined")
  else
    # Single-token pass that may still contain "(...)" on its own.
    p="${p//(/}"
    p="${p//)/}"
    MQSS_PASS_ARGS+=("--$p")
    (( i++ ))
  fi
  if [[ "$p" == *"lower-quake-to-qir"* || "$p" == *"quake-to-qasm"* ]]; then
    MQSS_PASS_ARGS+=("-o" "/dev/null")
  fi
done


filename=$(basename "$INPUT_FILE")
# Dispatch to correct optimizer
if [[ "${EXT}" == "cpp" ]]; then
  info "Converting the input to MLIR and applying specified optimization passes.."
  GENERATED_MLIR="${filename%.*}.qke"

  echo " "
  if [[ -n "${OUT_DIR}" ]]; then
    info "Emitting to Output Dir..."
    cudaq-quake "${INPUT_FILE}" -o "${OUT_DIR}/${GENERATED_MLIR}"
    mqss-opt "${OUT_DIR}/${GENERATED_MLIR}" "${MQSS_PASS_ARGS[@]}" -o "${OUT_DIR}/${GENERATED_MLIR}"
  else
    echo ${MQSS_PASS_ARGS[@]}
    cudaq-quake "${INPUT_FILE}" | mqss-opt "${MQSS_PASS_ARGS[@]}"
  fi
elif [[ "${EXT}" == "py" ]]; then
    blank

    msg "Python job details..."
    info "Function name: ${FUNCTION_NAME}"
    info "Stage: ${STAGE}"
    info "Resolver file: ${RESOLVER}"
    info "Passes: ${PASSES}"
    info "Out Dir: ${OUT_DIR}"

    if python3.11 -c "import catalyst"; then
     info "Catalyst python package found in current env"
    else
      warn "Catalyst python package not found"
      warn "Please enable the python virtual environment: source  MQSS-Passes-Suite/build/_deps/venv/bin/activate"
      exit 1
    fi

    COMMAND=""

    if [[ "${OUT_DIR}" != "" ]]; then
      COMMAND="$(
      python3.11 "${RESOLVER}" \
        --input "${INPUT_FILE}" \
        --function "${FUNCTION_NAME}" \
        --stage "${STAGE}" \
        --out-dir "${OUT_DIR}"
      )"
      MLIR_FILE="${OUT_DIR}/${FUNCTION_NAME}-${STAGE}.mlir"
      if [[ -e "${MLIR_FILE}" ]]; then
        info "MLIR Extracted: ${MLIR_FILE}"
      else
        warn "MLIR dialect could not be extracted"
        exit 1
      fi
      mqss-opt "${MLIR_FILE}" "${MQSS_PASS_ARGS[@]}" -o "${MLIR_FILE}"
    else
      python3.11 "${RESOLVER}" \
        --input "${INPUT_FILE}" \
        --function "${FUNCTION_NAME}" \
        --stage "${STAGE}" |  mqss-opt "${MQSS_PASS_ARGS[@]}"

    fi
else
    warn "Unknown input type: $INPUT_FILE"
    exit 1
fi
